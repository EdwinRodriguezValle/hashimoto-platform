# Local development only. Do not reuse these values outside your machine.

# PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_NAME=patient_db
DB_USER=postgres
DB_PASSWORD=postgres

# Kafka
KAFKA_HOST=kafka
KAFKA_INTERNAL_PORT=29092
KAFKA_EXTERNAL_PORT=9092

# Keycloak Compose service name
KEYCLOAK_HOST=keycloak

# Container log paths mounted under ./logs
LOG_PATH_PATIENT=/app/logs/patient-service.log
LOG_PATH_GATEWAY=/app/logs/api-gateway.log
